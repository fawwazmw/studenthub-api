generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model notes {
  id             Int      @id @default(autoincrement())
  user_id        Int
  title          String
  content        String
  category       String
  file_url       String?
  is_handwriting Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([user_id])
}

model tasks {
  id          Int      @id @default(autoincrement())
  user_id     Int
  title       String
  description String?
  category    String
  due_date    DateTime
  is_done     Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([due_date])
  @@index([user_id])
}

model users {
  id                    Int                 @id @default(autoincrement())
  name                  String
  email                 String              @unique
  password              String
  avatar_url            String?
  theme                 String              @default("system")
  notifications_enabled Boolean             @default(true)
  language              String              @default("en")
  total_points          Int                 @default(0)
  current_streak        Int                 @default(0)
  created_at            DateTime            @default(now())
  updated_at            DateTime
  notes                 notes[]
  tasks                 tasks[]
  wellbeing_entries     wellbeing_entries[]
}

model wellbeing_entries {
  id         Int      @id @default(autoincrement())
  user_id    Int
  date       DateTime @default(now()) @db.Date
  mood       Int
  energy     Int
  sleep      Int
  activities String[]
  note       String?
  created_at DateTime @default(now())
  updated_at DateTime
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@index([date])
  @@index([user_id])
}
