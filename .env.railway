# Environment
NODE_ENV=production
PORT=3000

# Database (Railway will provide this automatically)
# DATABASE_URL will be auto-injected by Railway
# Format: postgresql://username:password@host:port/database

# JWT - IMPORTANT: Change this to a strong random string!
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_IN_RAILWAY
JWT_EXPIRES_IN=7d

# CORS - Update with your Flutter app domain
# For development, allow all origins or specific domains
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
